# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# O .env.local NUNCA vai para o GitHub (contém senhas).

# --- Supabase: painel do projeto > botão "Connect" (topo) > aba "App Frameworks" ---
# ou Project Settings > Data API (URL) e Project Settings > API Keys (chave)
NEXT_PUBLIC_SUPABASE_URL=https://COLE_AQUI.supabase.co
# Chave "Publishable" (começa com sb_publishable_). É pública, pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI

# --- Banco: painel do projeto > botão "Connect" (topo) > aba "Connection String" ---
# Substitua [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.

# "Transaction pooler" (porta 6543) — usado pelo app
DATABASE_URL=postgresql://postgres.COLE_AQUI:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# "Session pooler" (porta 5432) — usado para criar/alterar tabelas (migrações)
DATABASE_URL_MIGRATIONS=postgresql://postgres.COLE_AQUI:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
